# ---- Backend ---------------------------------------------------
PORT=8080

# MQTT broker (TLS, port 8883 - see broker/README.md for cert + account setup)
MQTT_URL=mqtts://localhost:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Path to your CA cert when using a self-signed broker cert (empty for public-CA brokers)
MQTT_CA=
MQTT_REJECT_UNAUTHORIZED=true

# All devices publish under <TOPIC_PREFIX>/<deviceId>/...
TOPIC_PREFIX=solarcool

# --- Command-path security ---
# Required header on POST /api/commands:  Authorization: Bearer <token>
OPERATOR_TOKEN=
# Must match COMMAND_KEY in the ESP32 firmware; commands without it are ignored by hardware
COMMAND_KEY=

# Storage. Default is a local SQLite file (zero setup).
# For Postgres (e.g. Render's managed Postgres): postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite://./data/solarcool.db

# Comma-separated allowed origins for the dashboard, or * during development
CORS_ORIGIN=*
