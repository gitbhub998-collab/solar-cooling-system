{
  "rules": {
    "panels": {
      ".read": true,
      ".write": "auth != null",
      "$panel": {
        ".validate": "newData.hasChildren(['temperature','voltage','current','power'])",
        "temperature": { ".validate": "newData.isNumber() && newData.val() > -40 && newData.val() < 150" },
        "voltage":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
        "current":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 50" },
        "power":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2000" }
      }
    },
    "ambient": {
      ".read": true,
      ".write": "auth != null",
      "temperature": { ".validate": "newData.isNumber()" }
    },
    "battery": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['voltage','percentage'])",
      "voltage":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 60" },
      "percentage":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
    },
    "controls": {
      ".read": "auth != null",
      ".write": true,
      "fan":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
      "pump": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
    }
  }
}
